datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id             String       @id @db.VarChar(50)
  name           String       @db.VarChar(100)
  publicWriteKey String       @unique @map("public_write_key") @db.VarChar(100)
  allowedOrigins String[]     @default(["http://localhost:3000"]) @map("allowed_origins")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  clickEvents    ClickEvent[]
  ctaMetrics     CtaMetric[]

  @@map("projects")
}

model ClickEvent {
  id        BigInt   @id @default(autoincrement())
  projectId String   @default("prj_default") @map("project_id") @db.VarChar(50)
  elementId String   @map("element_id") @db.VarChar(100)
  pagePath  String   @map("page_path") @db.VarChar(255)
  sessionId String   @map("session_id") @db.VarChar(100)
  userId    Int?     @map("user_id")
  userAgent String?  @map("user_agent") @db.Text
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)], map: "idx_click_events_project_time")
  @@index([projectId, elementId, pagePath], map: "idx_click_events_project_element")
  @@map("click_events")
}

model CtaMetric {
  projectId     String   @default("prj_default") @map("project_id") @db.VarChar(50)
  elementId     String   @map("element_id") @db.VarChar(100)
  pagePath      String   @map("page_path") @db.VarChar(255)
  totalClicks   BigInt   @default(0) @map("total_clicks")
  lastClickedAt DateTime @default(now()) @map("last_clicked_at") @db.Timestamptz()

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, elementId, pagePath])
  @@map("cta_metrics")
}
