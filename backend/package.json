{
  "name": "backend-tracking-api",
  "version": "1.0.0",
  "description": "Cloudflare Workers + Hono + D1 Tracking Backend",
  "main": "src/worker.ts",
  "scripts": {
    "dev": "wrangler dev --port 5000",
    "deploy": "wrangler deploy",
    "d1:migrate:remote": "wrangler d1 execute traffic_analytics_db --file=./schema.d1.sql --remote",
    "d1:migrate:local": "wrangler d1 execute traffic_analytics_db --file=./schema.d1.sql --local"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "hono": "^4.12.25"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "wrangler": "^4.151.2"
  }
}
